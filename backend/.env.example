# Copy to backend/.env. Never commit credentials.
APP_ENV=development
SECRET_KEY=
# Choose mongo for Atlas; sqlite is explicitly local development only.
DATABASE_BACKEND=sqlite
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DATABASE=veritas
GOOGLE_FACT_CHECK_API_KEY=
# Optional source-grounded report summaries and report Q&A using retrieved excerpts.
# Create a key in Google AI Studio; the key is used only by the backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# public: free fact-check archives and publisher RSS feeds, no API key/card.
# local: offline evidence retrieval, build the corpus before use.
# rss: recent publisher feeds only. gdelt: optional keyless API.
# google: requires a Google API key. none: offline.
EVIDENCE_PROVIDER=public
EVIDENCE_MODEL_PATH=models/evidence/index.joblib
IMAGE_MODEL_PATH=models/image-v2/model.joblib
TEXT_MODEL_PATH=models/text
# Evaluation target, never a replacement for measured model probabilities.
MODEL_TARGET_ACCURACY=.90
TEMPORAL_MODEL_PATH=models/video-temporal/model.joblib
AI_IMAGE_MODEL_PATH=models/ai-image
AI_TEXT_MODEL_PATH=models/ai-text/model.joblib
WHISPER_MODEL=
COOKIE_SECURE=false
PORT=5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_TTL_SECONDS=3600
# Configure an SMTP account (for example, a Gmail app password) to enable email recovery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=12
